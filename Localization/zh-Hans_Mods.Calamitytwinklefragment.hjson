	FragmentTravelAdvertisement: {
		DisplayName: 吉光片羽：旅游广告
		Tooltip: 寄宿其上的低语流入你的耳中……
	}

	StarWish: {
		DisplayName: 星愿
		Tooltip:
			'''
			左键发射星星，星星停滞数秒后追踪敌人
			右键消耗500魔力值在鼠标处生成一个黑洞
			黑洞会吸引敌人并在8秒后爆炸
			再次按右键会瞬移到黑洞位置并提前引爆黑洞
			[c/FFFF00:“将这美好的瞬间化作永远]
			[c/FFFF00:  我的 世界全由你谱写”]
			'''
	}

	FraMoldyPaper: {
