Calamitytwinklefragment/Content/Items/Accessories/Mana/StarFlameStone: {
	StarFlameStone: {
		DisplayName: 星炎石
		Tooltip:
			'''
			饮用魔力药水时会使你获得魔力烧蚀减益而非魔力疾病减益
			魔力烧蚀会持续对你造成伤害，伤害与减益的强度相关
			玩家处于魔力烧蚀时魔法伤害变为1.2倍，受到伤害增加
			“如星星般燃烧！”
			'''
	}
}

