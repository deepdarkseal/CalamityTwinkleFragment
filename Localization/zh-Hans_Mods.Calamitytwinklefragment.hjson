# This file will automatically update with entries for new content after a build and reload.


Items: {
	DeepRed: {
		DisplayName: 深红
		Tooltip:
			'''
			连续劈砍会强化刀刃
			击中敌人引发爆炸
			[c/ff4048:“它被染上深红 枯了又荣”]
			'''
	}

	DragonfireAmberPauldron: {
		DisplayName: 龙火涎香肩甲
		Tooltip:
			'''
			冲刺速度提升32%，间隔减少33%
			撞击中敌人后会获得强化
			冲刺期间获得10%伤害减免
			你的冲刺会用龙焰和深渊水压撕碎附近的敌人
			连续冲刺会重新引爆上一次的路径     
			'''
	}

	WeightedLeatherBall: {
		DisplayName: 加重皮革球
		Tooltip:
			'''
			增加10%鞭子范围
			鞭子伤害变为1.5倍
			但会降低10%的召唤物伤害
			'''
	}

	WhipHookBlade: {
		DisplayName: 鞭钩刃
		Tooltip:
			'''
			增加10%召唤伤害
			增加10%鞭子伤害
			鞭子攻击会对敌人造成切割和流血减益
			'''
	}

	TheAngerOfTheFarmer: {
		DisplayName: 奴役之手
		Tooltip:
			'''
			增加10%召唤伤害和鞭子范围
			以及16鞭子攻速
			鞭子伤害变为1.6倍
			但会降低10%召唤物伤害
			鞭子攻击会对敌人造成切割和流血减益
			'''
	}

	ManaBonsai: {
		DisplayName: 魔力盆景
		Tooltip:
			'''
			魔力消耗降低9%
			增加50点最大魔力值
			需要时自动使用魔力药水
			基于最大魔力值增加暴击率
			“一个巫师的盆景就如同他的魔法水平”
			'''
	}

