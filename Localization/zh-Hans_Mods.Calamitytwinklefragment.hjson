	}

	FinalPray: {
		DisplayName: 最终祈愿
		Tooltip:
			'''
			左键发射星星追踪敌人
			右键消耗300魔力值在鼠标处生成一个黑洞
			黑洞会吸引敌人并在8秒后爆炸
			再次按右键会提前引爆黑洞
			[c/FFFF00:“虚无洁白 像漂浮着的尘埃]
			[c/FFFF00:  失去光 也失去所有色彩”]
			'''
	}

	EtherealTalismanPlus: {
		DisplayName: 空灵护符+
		Tooltip:
			'''
			增加15%魔法伤害、5%魔法暴击率并降低10%魔力消耗
			增加200点最大魔力值
