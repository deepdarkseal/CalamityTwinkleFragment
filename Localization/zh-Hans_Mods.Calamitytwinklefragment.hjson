			'''
	}

	StardustFaling: {
		DisplayName: 尘降
		Tooltip:
			'''
			左键发射星星，星星停滞数秒后追踪敌人
			右键消耗100魔力值降下群星
			[c/FFFF00:“若你能命中我]
			[c/FFFF00:  自宇宙的中央”]
			'''
	}

	LicenseYan: {
		DisplayName: 不稳定的盐喵许可证
		Tooltip:
			'''
			召唤盐喵与你并肩作战
			半血以下时盐喵会趴在头上治愈你
			受到伤害时会根据损失的肾上腺素来恢复生命值
			[c/008611:- 开发者物品 -]
			'''
	}

	AetherialDream: {
		DisplayName: 纯白翼之梦
		Tooltip:
			'''
			水平飞行速度：15
			加速倍率：5
			绝佳的垂直飞行速度
			飞行时间：3600
			每15秒可以用羽毛将一次伤害变为1
			[c/FFFFFF:“承载着梦想的纯白翅膀]
			[c/FFFFFF: 翱翔在遥远无尽的云端彼方”]
			[c/EE86EE:- 专属物品 -]
			'''
	}

	MagnetiteDice: {
		DisplayName: 磁石骰
		Tooltip:
			'''
			增加5%暴击和0.2点幸运
			“我真幸运”
			'''
	}

	MoonlightGreatsword: {
		DisplayName: 月光大剑
		Tooltip:
			'''
			左键挥动大剑，连续三段斩击
			右键消耗80点魔力，将月光凝聚于剑身，持续45秒
			附魔期间左键也会释放月光波，第三段更强
			附魔期间右键：重击并释放大型月光波，按住可自动挥舞
			附魔期间伤害提高30%，暴击率提高8%
			[c/9FCBFF:“冰冷的黑暗满月”]
			'''
		MoonlightTime: 月光附魔剩余：{0}秒
	}

	SyzygyBow: {
		DisplayName: 朔望
		Tooltip: 人有悲欢离合，月有阴晴圆缺
	}

	GreatTitStaff: {
		DisplayName: 大山雀杖
		Tooltip:
			'''
			召唤1只可爱的大山雀为你而战
			可爱但凶狠
			'''
	}

	PutridCauldron: {
		DisplayName: 腐败坩埚
		Tooltip:
			'''
			召唤腐败之主
			不消耗
			永恒的生命与腐烂
			'''
	}

	WeaverSong: {
		DisplayName: 编织者之歌
		Tooltip:
			'''
			召唤小编织者为你而战
			“它们看见了你的美丽，脆弱而精致”
			'''
	}

	CMoon: {
		DisplayName: 新月
		Tooltip: 左键挥舞，右键投出镰刀
	}

	// Placeables.AuricSlimeBanner.DisplayName: Auric Slime Banner

	SerpentHunter: {
		DisplayName: 狩猎大蛇矛
		Tooltip:
			'''
			左键横扫，右键向前突刺
			附近有巨蛇类敌人时，剑气附着于矛身，延长攻击距离
			剑气对巨蛇类敌人造成 3 倍伤害
			“猎蛇，不猎它的影子。”
			'''
	}

	ScissorBlade: {
		DisplayName: 断斩之剪
		Tooltip:
			'''
			左键五连剪击，前四段甩出撕裂之针，第五段掷出剪刀
			掷出剪刀后松开左键可合拢双刃
			右键切腹：消耗当前生命 10%，换取无敌帧与充能
			有充能时伤害提升；满充能时按住上键右键释放大撕裂
			“剪开一切，包括自己。”
			'''
		ChargeInfo: 当前充能：{0}/{1}
	}
}

