	SerpentHunter: {
		DisplayName: Serpent Hunter
		Tooltip:
			'''
			Left click to sweep; right click to thrust forward
			While serpentine enemies are near, a blade wave clings to the spear and extends its reach
			The blade wave deals 3x damage to serpentine enemies
			"Hunt the serpent, not its shadow."
			'''
	}

	ScissorBlade: {
		DisplayName: Scissor Blade
		Tooltip:
			'''
			Left click for a five-hit scissor combo; the first four hits throw rending needles, the fifth hurls the scissor
			Release left click right after the throw to snap the blades shut
			Right click to perform seppuku: spend 10% of your current life for invincibility frames and charges
			Charges sharpen the scissor; at full charge, hold Up and right click to unleash the Big Rip
			"Cut everything, including yourself."
			'''
		ChargeInfo: Charge: {0}/{1}
	}
