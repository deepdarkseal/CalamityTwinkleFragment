	MoonlightGreatsword: {
		DisplayName: Moonlight Greatsword
		Tooltip:
			'''
			Left click: three-hit greatsword combo
			Right click: spend 80 mana to imbue the blade with moonlight for 45 seconds
			While imbued, left clicks also release moonlight waves; the third hit is stronger
			While imbued, right click: heavy slash with a large moonlight wave; hold to auto-swing
			Imbued: +30% damage and +8% critical strike chance
			[c/9FCBFF:"The cold, dark moon"]
			'''
		MoonlightTime: Moonlight remaining: {0}s
	}

